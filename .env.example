# Local data
DATABASE_URL=file:./data/job-copilot.db

# Provider (DEFAULT_PROVIDER and OLLAMA_MODEL remain supported for the original CLI)
AI_PROVIDER=ollama
DEFAULT_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Used when no --model option is supplied. The model must already be installed locally.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EXTRACTION_MODEL=qwen3:8b
OLLAMA_REASONING_MODEL=deepseek-r1:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Version 1 intentionally uses no paid or search-engine discovery service.
WEB_SEARCH_PROVIDER=none

GREENHOUSE_ENABLED=true
LEVER_ENABLED=true
ASHBY_ENABLED=true
CAREERS_CRAWLER_ENABLED=true

DETAILED_ANALYSIS_LIMIT=25
MAX_JOB_AGE_DAYS=30
JOB_DISCOVERY_CONCURRENCY=4
JOB_FETCH_TIMEOUT_MS=15000
JOB_FETCH_RETRY_LIMIT=2
JOB_FETCH_MAX_RESPONSE_BYTES=5000000

CAREERS_CRAWLER_MAX_DEPTH=2
CAREERS_CRAWLER_MAX_PAGES_PER_COMPANY=100
CAREERS_CRAWLER_CONCURRENCY=3
CAREERS_CRAWLER_TIMEOUT_MS=15000
CAREERS_CRAWLER_MAX_RESPONSE_BYTES=5000000
CAREERS_CRAWLER_DELAY_MS=250

# Local dashboard
HOST=127.0.0.1
PORT=4310

# Optional benchmark cache/report root. Defaults to the platform application-data directory.
# CV_MATCH_AGENT_DATA_DIR=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
